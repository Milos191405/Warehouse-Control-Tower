{
  "name": "Warehouse Control Tower Dark",
  "dataColors": [
    "#38BDF8",
    "#3B82F6",
    "#94A3B8",
    "#10B981",
    "#F59E0B",
    "#EF4444",
    "#A78BFA",
    "#2DD4BF"
  ],
  "background": "#111317",
  "foreground": "#F8FAFC",
  "tableAccent": "#FF000F",
  "good": "#10B981",
  "neutral": "#F59E0B",
  "bad": "#EF4444",
  "maximum": "#38BDF8",
  "center": "#F59E0B",
  "minimum": "#EF4444",
  "null": "#475569",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#F8FAFC"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#F8FAFC"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#CBD5E1"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#94A3B8"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#1B1F26" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#2A303B" } },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "fontColor": { "solid": { "color": "#F8FAFC" } },
            "background": { "solid": { "color": "#1B1F26" } }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#111317" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#0B0D10" } }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": { "solid": { "color": "#E2E8F0" } },
            "background": { "solid": { "color": "#111317" } }
          }
        ]
      }
    }
  }
}
